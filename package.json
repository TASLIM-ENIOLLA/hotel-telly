{
  "name": "hotel-telly-cms",
  "version": "1.0.0",
  "description": "A hotel and reservation app with a headless cms that allows easy and quick content editing and customization",
  "keywords": [
    "hotel",
    "reservation",
    "cms"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TASLIM-ENIOLLA/hotel-telly.git"
  },
  "license": "ISC",
  "author": "TASLIM-ENIOLLA",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "client": "yarn dev --prefix ../client/",
    "server": "yarn dev --prefix ../server/",
    "setup:client": "cd client && yarn",
    "setup:server": "cd server && yarn",
    "setup": "yarn install && yarn setup:client && yarn setup:server",
    "dev": "yarn concurrently \"cd server && yarn develop\" \"npx wait-on http://localhost:1337 && cd client && yarn dev\""
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/numeral": "^2.0.5",
    "@types/qs": "^6.14.0",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.5",
    "js-cookie": "^3.0.5",
    "numeral": "^2.0.6",
    "qs": "^6.15.0",
    "react-countup": "^6.5.3",
    "zustand": "^5.0.11"
  }
}
